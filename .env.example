# =============================================================================
# Paperclip Docker — Environment Variables
# Copy to .env and fill in: cp .env.example .env
# =============================================================================

# ── Required ─────────────────────────────────────────────────────
# Auth secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL where Paperclip will be accessible (your domain)
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com

# ── Database ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ── AI Agent API Keys ────────────────────────────────────────────
# Not configured here. Anything in the server environment is inherited by
# every agent subprocess. Add provider keys to Paperclip's encrypted secret
# store after first login and reference them per agent with secret_ref —
# see "Configure Secrets" in the README.
